{
  "id": "com.wangxulong.superisland.synced-lyrics",
  "name": "同步歌词",
  "version": "0.11.1",
  "minAppVersion": "1.0.2",
  "main": "bundle.js",
  "author": {
    "name": "wangxulong"
  },
  "description": "在 SuperIsland 中显示逐行与逐字同步歌词，配合原生歌词特效。",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": [
    "music",
    "utilities"
  ],
  "permissions": [
    "media",
    "network",
    "storage"
  ],
  "capabilities": {
    "compact": true,
    "expanded": true,
    "fullExpanded": true,
    "minimalCompact": true,
    "backgroundRefresh": true,
    "settings": true
  },
  "layout": {
    "expandedHeight": 180,
    "fullExpandedHeight": 240
  },
  "refreshInterval": 0.5,
  "activationTriggers": [
    "manual",
    "timer"
  ],
  "defaultEnabled": false
}
